# ============================================================
# 复制本文件为 .env 并填入真实凭证。.env 已被 .gitignore 排除。
# 凭证只允许出现在后端进程内，绝不写进前端代码或提交到仓库。
#
# 本文件会提交到仓库：只保留变量名，任何一项都不要填真实值。
# ============================================================

# AusPost / StarTrack testbed 凭证（HTTP Basic：username = Key，password = Password）
AUSPOST_API_KEY=
AUSPOST_API_PASSWORD=

# 必填 header `account-number`，缺少时 prices/shipments 会直接 400
AUSPOST_ACCOUNT_NUMBER=

# partner API 基地址。留空则使用代码默认值（见 backend/app/config.py）。
AUSPOST_BASE_URL=

# 起运地。留空则回退到 data/orders.json 的 origin 节点。
# 注意：题目给的 2111(Ryde) 与 AusPost testbed 数据不一致，suburb=RYDE&postcode=2111 会 400，
# 因此 suburb 建议留一个已验证可用的值（如 GLADESVILLE）。
ORIGIN_POSTCODE=
ORIGIN_SUBURB=
ORIGIN_STATE=

# partner API 超时（秒）。超时进入明确降级态。
HTTP_TIMEOUT_SECONDS=8

# GST 税率（澳大利亚为 10%）
GST_RATE=0.10

# 数据文件位置与文件名
DATA_DIR=
# 首页加载的订单数据集：orders.json（题目给的）+ orders_generated.json（自己生成的测试订单）
ORDER_DATASET_PATTERN=orders*.json
SKU_CATALOG_FILE=sku_catalog.json

# 故意造坏的边界数据集与测试接口开关。生产保持 false：
# /api/testcases 返回 404，首页不出现这批数据，页面也没有测试页入口。
# 需要跑测试页（/tests.html）时临时置为 true。
TEST_DATASET_PATTERN=testcases_edge.json
EXPOSE_TESTCASES=false

# partner API 结果缓存时长（秒）：正常结果较久，降级结果很短（便于自动恢复）
AUSPOST_CACHE_TTL_SECONDS=900
AUSPOST_DEGRADED_CACHE_TTL_SECONDS=30
